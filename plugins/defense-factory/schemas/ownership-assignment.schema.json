{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kenhuangus/defense-factory-skills/schemas/ownership-assignment.schema.json",
  "title": "OwnershipAssignment",
  "description": "Maps a validated finding to an accountable owner for the Ownership phase.",
  "type": "object",
  "required": [
    "id",
    "finding_id",
    "owner",
    "assigned_at",
    "priority",
    "sla_due"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "finding_id": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "description": "Person or team with fix accountability"
    },
    "backup_owner": {
      "type": "string"
    },
    "assigned_at": {
      "type": "string"
    },
    "assigned_by": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": ["p0", "p1", "p2", "p3"]
    },
    "sla_due": {
      "type": "string",
      "description": "ISO-8601 due date for remediation start or completion per SECURITY.md"
    },
    "routing_rationale": {
      "type": "string"
    },
    "tracker_url": {
      "type": "string",
      "description": "Issue tracker URL if created"
    },
    "status": {
      "type": "string",
      "enum": ["assigned", "accepted", "reassigned", "blocked"]
    }
  }
}
